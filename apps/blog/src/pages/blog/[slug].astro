---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FeatureMedia from '../../components/editorial/FeatureMedia.astro'
import ArticleMeta from '../../components/editorial/ArticleMeta.astro'
import { RichTextRenderer } from '../../components/RichTextRenderer'
import { CATEGORY_LABELS, getPostBySlug } from '../../lib/payload-client'

const { slug } = Astro.params
const post = slug ? await getPostBySlug(slug) : null

if (!post) {
  return Astro.redirect('/blog')
}
---

<BaseLayout title={post.title} activeCategory={post.category}>
  <!-- Mídia vertical 100vh no topo de todo artigo — decisão explícita da v6
       (handoff § changelog: "confirmado em todo artigo, não só na home"). -->
  <FeatureMedia
    imageUrl={post.featuredImage?.url}
    alt={post.featuredImage?.alt}
    eyebrow={CATEGORY_LABELS[post.category]}
    title={post.title}
  />

  <section class="article-shell" id="article">
    <ArticleMeta post={post} />
    <article class="article">
      <RichTextRenderer data={post.content} client:load />
    </article>
  </section>
</BaseLayout>
