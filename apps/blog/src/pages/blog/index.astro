---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { PostCard } from '../../components/PostCard'
import { getPosts } from '../../lib/payload-client'

const posts = await getPosts()
---

<BaseLayout title="Blog">
  <h1 class="text-h1" style="margin-bottom: var(--space-6);">Blog</h1>
  {
    posts.length === 0 ? (
      <p class="text-body" style="color: var(--semantic-text-secondary);">Nenhum post publicado ainda.</p>
    ) : (
      <div class="post-grid">
        {posts.map((post) => (
          <PostCard post={post} client:load />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  /*
   * Grid de listagem de posts — RESPONSIVE-SPEC.md: "3 colunas desktop / 2
   * tablet / 1 mobile". A `.grid` genérica de layout.css é o primitivo de
   * 12/8/4 colunas iguais do sistema (RESPONSIVE-SPEC.md geral); usá-la
   * direto aqui deixava cada PostCard ocupando 1 de 8 tracks (uma coluna
   * muito estreita) porque um card não tem `grid-column: span`. Card
   * listagens usam sua própria grade de largura mínima, não a grade de
   * layout genérica.
   */
  .post-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .post-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .post-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
