---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/editorial/Hero.astro'
import FeatureMedia from '../../components/editorial/FeatureMedia.astro'
import PromoGrid from '../../components/editorial/PromoGrid.astro'
import Selection from '../../components/editorial/Selection.astro'
import Carousel from '../../components/editorial/Carousel.astro'
import { getPosts, pickSelection, pickCarousel, CATEGORY_LABELS, type PostCategory } from '../../lib/payload-client'

const allPosts = await getPosts()

const categoriaParam = Astro.url.searchParams.get('categoria') as PostCategory | null
const activeCategory = categoriaParam && categoriaParam in CATEGORY_LABELS ? categoriaParam : undefined
const posts = activeCategory ? allPosts.filter((p) => p.category === activeCategory) : allPosts

const selectionPosts = pickSelection(posts, 3)
const carouselPosts = pickCarousel(posts, selectionPosts, 6)
const featurePost = selectionPosts[0]
---

<BaseLayout title={activeCategory ? CATEGORY_LABELS[activeCategory] : 'Blog'} activeCategory={activeCategory} activeTab="inicio">
  <Hero
    eyebrow={activeCategory ? CATEGORY_LABELS[activeCategory] : 'Editorial'}
    title="Histórias profundas. Interface silenciosa."
    description="Uma experiência editorial que combina amarelo e preto de alto contraste com tipografia de sistema, navegação em drawer lateral e imagens verticais em tela cheia."
  />

  {
    featurePost && (
      <FeatureMedia
        id="feature"
        imageUrl={featurePost.featuredImage?.url}
        alt={featurePost.featuredImage?.alt}
        eyebrow={CATEGORY_LABELS[featurePost.category]}
        title={featurePost.title}
      />
    )
  }

  <PromoGrid />

  {
    posts.length === 0 ? (
      <p style="text-align:center;padding:48px;color:var(--muted);font-family:var(--sf-text)">
        Nenhum post publicado nesta categoria ainda.
      </p>
    ) : (
      <>
        {selectionPosts.length > 0 && <Selection posts={selectionPosts} />}
        {carouselPosts.length > 0 && <Carousel posts={carouselPosts} />}
      </>
    )
  }
</BaseLayout>
