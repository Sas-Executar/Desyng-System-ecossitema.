---
import Button from './Button.astro'

interface Props {
  eyebrow: string
  title: string
  description: string
}
const { eyebrow, title, description } = Astro.props as Props
---

<!-- Hero — única por página, fundo sempre --paper, animação de entrada
     única no load (handoff § Componentes / Estados e Interações). -->
<section class="hero">
  <div class="hero-inner">
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="hero-actions">
      <Button variant="accent" href="#feature">Ler destaque</Button>
      <Button variant="outline-dark" href="#selection">Ver seleção</Button>
    </div>
  </div>
</section>
