---
import '../styles/global.css'

interface Props {
  title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · EXECUTAR Blog</title>
  </head>
  <body>
    <header class="container" style="padding-block: var(--space-6); border-bottom: var(--border-width-thin) solid var(--semantic-border-default);">
      <a href="/blog" style="font-weight: var(--font-weight-h3); color: var(--semantic-text-primary); text-decoration: none;">
        EXECUTAR Blog
      </a>
    </header>
    <main class="container" style="padding-block: var(--space-8);">
      <slot />
    </main>
    <footer class="container" style="padding-block: var(--space-6); border-top: var(--border-width-thin) solid var(--semantic-border-default); color: var(--semantic-text-secondary);">
      <p class="text-caption">EXECUTAR — Desyng System</p>
    </footer>
  </body>
</html>
