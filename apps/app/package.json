{
  "name": "@executar/app",
  "version": "0.1.0",
  "description": "EXECUTAR App — Expo + React Native + Tamagui, consuming @executar/design-tokens (tokens.native) and reimplementing @executar/ui's component API for native. Compile/typecheck-verified only in this sandbox — no Android/iOS SDK or emulator available (see README).",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform web"
  },
  "dependencies": {
    "@executar/callout-protocol": "workspace:*",
    "@executar/design-tokens": "workspace:*",
    "@tamagui/config": "2.7.7",
    "expo": "57.0.20",
    "expo-constants": "57.0.17",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "babel-preset-expo": "57.0.10",
    "@types/react": "19.2.14",
    "typescript": "^5.7.2"
  }
}
